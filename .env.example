# ── CRM_YE configuration ──────────────────────────────────────────────────────
# Local development: copy to .env.local.   Server (pm2/CloudPanel): .env.production.local.
# Docker: copy to .env next to docker-compose.yml.   Full guide: DEPLOY.md

# ── Docker only (docker-compose.yml) ──────────────────────────────────────────
# Your domain, without https:// — Caddy gets the HTTPS certificate for it.
DOMAIN=crm.example.co.il
# Password for the bundled PostgreSQL (random, e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=change-me

# ── Required ──────────────────────────────────────────────────────────────────
# Public address of the site (https in production). Used in links sent to clients.
# (Docker sets this itself from DOMAIN.)
APP_BASE_URL=http://localhost:3000

# PostgreSQL connection string. (Docker sets this itself from POSTGRES_PASSWORD.)
DATABASE_URL=postgresql://crmye:change-me@localhost:5432/crmye

# Root admin login (password-only sign-in). Prefer a bcrypt hash in production:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your-password'
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=
ADMIN_EMAIL=admin@example.com
# Root admin's WhatsApp number for reminders (e.g. 0501234567 or 972501234567).
ADMIN_PHONE=

# Signs session cookies and client download links. Random, 32+ characters:
#   openssl rand -hex 32
# Moving to another server? Copy this value too, or links already sent to clients stop working.
ADMIN_SESSION_SECRET=change-me-session-secret
ADMIN_SESSION_HOURS=24

# ── Email (Resend) — https://resend.com ───────────────────────────────────────
# Create an API key, verify your sending domain, then set:
RESEND_API_KEY=
# Must use the verified domain, e.g.  משרד יעוץ <noreply@your-domain.co.il>
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── WhatsApp (Meta Cloud API) — see docs/WHATSAPP-SETUP.md ────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Verifies Meta's delivery-status webhooks (App settings → Basic → App secret).
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANG=he
# Template names (defaults shown) — create them in WhatsApp Manager, see docs/WHATSAPP-SETUP.md
# WHATSAPP_TEMPLATE_OTP=crmye_password_reset
# WHATSAPP_TEMPLATE_DOCUMENTS=crmye_documents_link
# WHATSAPP_TEMPLATE_REMINDER=crmye_task_reminder
# WHATSAPP_TEMPLATE_TASK_ASSIGNED=crmye_task_assigned
# WHATSAPP_TEMPLATE_CHAT=crmye_chat_message
# Country code added to local numbers (050… → 97250…).
DEFAULT_COUNTRY_CODE=972

# ── Server ────────────────────────────────────────────────────────────────────
# Header your reverse proxy puts the client IP in (login rate limiting):
#   nginx / CloudPanel: x-real-ip      Caddy (Docker setup): x-forwarded-for
CLIENT_IP_HEADER=x-real-ip
# Time zone for dates in emails / WhatsApp messages.
APP_TIMEZONE=Asia/Jerusalem

# ── Storage ───────────────────────────────────────────────────────────────────
# Folder for client documents, chat attachments and templates. BACK IT UP.
DATA_DIR=./data
# Max upload size in bytes (default 25MB). Keep in sync with nginx client_max_body_size.
UPLOAD_MAX_FILE_BYTES=26214400
